    "html": "<div\nalign=\"center\"><center>\n\n<table border=\"0\" cellpadding=\"12\" cellspacing=\"0\" width=\"480\">\n    <tr>\n        <td align=\"center\" colspan=\"2\"><font color=\"#000000\"\n        size=\"4\" face=\"Tahoma\">Scorekeeping Software Available:</font></td>\n    </tr>\n    <tr>\n        <td valign=\"top\" width=\"240\"><a href=\"POM2004.zip\"><font\n        size=\"4\" face=\"Tahoma\"><strong>Match Scorekeeping:</strong></font></a></td>\n        <td width=\"240\"><font size=\"2\" face=\"Tahoma\"><strong>Excel-based\n        program used at the range for calculating handicaps and\n        match totals. </strong></font></td>\n    </tr>\n    <tr>\n        <td valign=\"top\" width=\"240\"><a\n        href=\"TeamAdmin2004.zip\"><font size=\"4\"\n        face=\"Tahoma\"><strong>Team Administration:</strong></font></a></td>\n        <td width=\"240\"><font size=\"2\" face=\"Tahoma\"><strong>Excel-based\n        program to track scores to keep indices updated and to\n        print scoresheets.</strong></font></td>\n    </tr>\n    <tr>\n        <td valign=\"top\" width=\"240\"><a href=\"Handicap.exe\"><font\n        size=\"4\" face=\"Tahoma\"><strong>Handicap Calculator:</strong></font></a></td>\n        <td width=\"240\"><font size=\"2\" face=\"Tahoma\"><strong>A\n        small DOS-based program to compute handicap scores</strong></font></td>\n    </tr>\n</table>\n</center></div>",
